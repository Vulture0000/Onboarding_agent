# Gemini API key (required for LLM reasoning + embeddings).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model configuration
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Database (SQLite file, relative to backend/)
DATABASE_URL=sqlite:///./data/onboarding.db

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth — change JWT_SECRET before any real deployment (HS256 needs >= 32 bytes).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=720

# Password given to every seeded demo account (login emails are fixed in seed.py).
DEMO_PASSWORD=Demo@1234
